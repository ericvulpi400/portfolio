{
  "name": "minifolks-packs-spike",
  "productName": "MiniFolks Packs Spike",
  "version": "0.0.1",
  "description": "Fase 0 \u2014 teste t\u00e9cnico: Canvas 2D, Electron, Steamworks, controle e build Windows",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prepare-assets": "node tools/copy-assets.mjs",
    "bench": "node tools/bench-browser.mjs",
    "dist:win": "node tools/copy-assets.mjs && node tools/fetch-win-natives.mjs && electron-builder --win dir zip --x64",
    "dist:linux": "node tools/copy-assets.mjs && electron-builder --linux dir --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "steamworks-ffi-node": "0.11.3"
  },
  "build": {
    "appId": "dev.minifolkspacks.spike",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks-ffi-node/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "steamworks_sdk",
        "to": "steamworks_sdk",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "dir",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  }
}
